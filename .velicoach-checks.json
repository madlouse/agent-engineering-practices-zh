{
  "docFirst": {
    "code": ["^src/(?!content/)", "^src/content/(?:types|index)\\.ts$", "^server/", "^migrations/"],
    "docs": ["^docs/prd/", "^docs/requirements/(?:trace|summary)\\.md$", "^docs/architecture/", "^docs/uiue/", "^docs/issues/"],
    "refs": ["docs/(?:prd|requirements|architecture|uiue|issues)/", "claude\\.ai/artifact/", "\\bADR-?\\d{4}\\b", "PRD\\s*§?\\s*\\d", "第\\s*\\d+\\s*条"]
  },
  "comments": {
    "paths": ["^src/(?!content/.*\\.md$)", "^server/", "^migrations/", "^scripts/"],
    "exclude": ["\\.md$"],
    "allow": []
  },
  "roles": {
    "source": ["^src/", "^server/", "^migrations/", "^public/"],
    "e2eCore": ["^tests/e2e/core/", "^tests/e2e/env\\.ts$"],
    "e2eCases": ["^tests/e2e/cases/"]
  },
  "e2eTrace": {
    "prd": ["^docs/prd/e2e-scenarios\\.md$"],
    "id": "\\b(S\\d{2})\\b",
    "cases": ["^tests/e2e/cases/"],
    "minCoverage": 0
  }
}
