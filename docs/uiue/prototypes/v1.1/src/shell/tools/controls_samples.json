 "loading_rows": "<div class=\"vc-loading vc-loading-rows\" aria-hidden=\"true\">\n              <span class=\"vc-skeleton\" style=\"width: var(--space-10); height: var(--space-5);\"></span>\n              \n                <div class=\"vc-loading-row\">\n                  <span class=\"vc-skeleton\" style=\"width: var(--space-7); height: var(--space-4);\"></span>\n                  <span class=\"vc-loading-row-body\">\n                    <span class=\"vc-skeleton vc-skeleton-w-62\" style=\"height: var(--space-5);\"></span>\n                    <span class=\"vc-skeleton vc-skeleton-w-88\" style=\"height: var(--space-4);\"></span>\n                  </span>\n                </div>\n              \n                <div class=\"vc-loading-row\">\n                  <span class=\"vc-skeleton\" style=\"width: var(--space-7); height: var(--space-4);\"></span>\n                  <span class=\"vc-loading-row-body\">\n                    <span class=\"vc-skeleton vc-skeleton-w-48\" style=\"height: var(--space-5);\"></span>\n                    <span class=\"vc-skeleton vc-skeleton-w-76\" style=\"height: var(--space-4);\"></span>\n                  </span>\n                </div>\n              \n                <div class=\"vc-loading-row\">\n                  <span class=\"vc-skeleton\" style=\"width: var(--space-7); height: var(--space-4);\"></span>\n                  <span class=\"vc-loading-row-body\">\n                    <span class=\"vc-skeleton vc-skeleton-w-70\" style=\"height: var(--space-5);\"></span>\n                    <span class=\"vc-skeleton vc-skeleton-w-84\" style=\"height: var(--space-4);\"></span>\n                  </span>\n                </div>\n              \n                <div class=\"vc-loading-row\">\n                  <span class=\"vc-skeleton\" style=\"width: var(--space-7); height: var(--space-4);\"></span>\n                  <span class=\"vc-loading-row-body\">\n                    <span class=\"vc-skeleton vc-skeleton-w-40\" style=\"height: var(--space-5);\"></span>\n                    <span class=\"vc-skeleton vc-skeleton-w-68\" style=\"height: var(--space-4);\"></span>\n                  </span>\n                </div>\n              \n                <div class=\"vc-loading-row\">\n                  <span class=\"vc-skeleton\" style=\"width: var(--space-7); height: var(--space-4);\"></span>\n                  <span class=\"vc-loading-row-body\">\n                    <span class=\"vc-skeleton vc-skeleton-w-56\" style=\"height: var(--space-5);\"></span>\n                    <span class=\"vc-skeleton vc-skeleton-w-90\" style=\"height: var(--space-4);\"></span>\n                  </span>\n                </div>\n              \n            </div>",
 "notice_action": "<div class=\"vc-notice vc-notice-action vc-read-wide\" role=\"alert\">\n        <p><strong>视频没能播放。</strong>文字稿讲的是同一件事，就在下面。</p>\n        <button type=\"button\" class=\"btn vc-btn-quiet\">重试</button>\n      </div>",
 "notice_block": "<div class=\"vc-notice vc-notice-block\" role=\"alert\">\n              <h2 class=\"vc-type-title-3\">里程碑这部分没加载出来</h2>\n              <p class=\"vc-sub\">可能是网络慢了一下。页面其余部分不受影响，学习路径照常可以看。</p>\n              <div class=\"vc-notice-actions\"><button type=\"button\" class=\"btn vc-btn-action\">重试</button><a class=\"vc-quick\" href=\"/mind/learn\">去学习路径</a></div>\n            </div>",
 "howto": "<section class=\"vc-howto\" aria-labelledby=\"vc-howto-title\">\n          <h2 id=\"vc-howto-title\" class=\"kicker vc-howto-title\">怎么做：四步</h2>\n          <ol class=\"vc-howto-steps\">\n            \n              <li class=\"vc-howto-step\">\n                <span class=\"vc-howto-n\" aria-hidden=\"true\">1</span>\n                <h3 class=\"vc-type-title-3\">挑一件真事</h3>\n                <p class=\"vc-type-body\">一件做完就能用的小事。</p>\n                <a class=\"vc-quick vc-quick-small\" href=\"/build/velicoach/home-motion\">日志：找回首页的动效</a>\n              </li>\n            \n              <li class=\"vc-howto-step\">\n                <span class=\"vc-howto-n\" aria-hidden=\"true\">2</span>\n                <h3 class=\"vc-type-title-3\">写清楚目标</h3>\n                <p class=\"vc-type-body\">做到什么算完成，怎么检查。</p>\n                <a class=\"vc-quick vc-quick-small\" href=\"/build/velicoach/quality-terms\">日志：把「体验友好」写成规则</a>\n              </li>\n            \n              <li class=\"vc-howto-step\">\n                <span class=\"vc-howto-n\" aria-hidden=\"true\">3</span>\n                <h3 class=\"vc-type-title-3\">交给智能体，自己验收</h3>\n                <p class=\"vc-type-body\">它出力，你判断；错了就改要求。</p>\n                <a class=\"vc-quick vc-quick-small\" href=\"/build/velicoach/two-reviewers\">日志：两个模型各审一遍</a>\n              </li>\n            \n              <li class=\"vc-howto-step\">\n                <span class=\"vc-howto-n\" aria-hidden=\"true\">4</span>\n                <h3 class=\"vc-type-title-3\">公开记一笔</h3>\n                <p class=\"vc-type-body\">哪里快、哪里卡，都写下来。</p>\n                <a class=\"vc-quick vc-quick-small\" href=\"/build/velicoach/cold-review\">日志：评审找出 11 处问题</a>\n              </li>\n            \n          </ol>\n        </section>",
 "facts": "<dl class=\"vc-facts\">\n          <div><dt class=\"vc-sr-only\">状态</dt><dd class=\"vc-status\">开发中</dd></div>\n          <div><dt>产品地址</dt><dd><a class=\"vc-quick\" href=\"/\">velicoach.com</a></dd></div>\n        </dl>",
 "deflist": "<dl class=\"vc-deflist\">\n          \n            <div><dt>产品负责人</dt><dd>定做什么；确认需求、设计和上线；发布后可以撤下任何内容。</dd></div>\n          \n            <div><dt>写的智能体</dt><dd>按拆好的任务实现功能、起草内容，每次改动都带上检查结果。</dd></div>\n          \n            <div><dt>审的智能体</dt><dd>另起一个没看过制作过程的智能体来评审；设计由两个不同的模型各审一遍。</dd></div>\n          \n            <div><dt>自动检查</dt><dd>术语、质量词和设计稿的检查通过以后才能合并；合并只走合并脚本。</dd></div>\n          \n        </dl>",
 "empty": "<div class=\"vc-empty\">\n          <p class=\"vc-type-body\">这个项目还没有开发日志。第一条写好后会出现在这里。</p>\n          <a class=\"vc-quick\" href=\"/build#devlog\">看全部项目的开发日志</a>\n        </div>",
 "deflist_numbered": "<dl class=\"vc-deflist vc-deflist-numbered\">\n      \n        <div><span class=\"vc-deflist-n mono\" aria-hidden=\"true\">1</span><dt>谁在维护</dt><dd>这个站由一位产品负责人和 AI 智能体一起维护。</dd></div>\n      \n        <div><span class=\"vc-deflist-n mono\" aria-hidden=\"true\">2</span><dt>哪些内容由智能体起草</dt><dd>文章、里程碑、学习路径步骤和开发日志由智能体起草；每周的订阅邮件只用已发布的内容拼成。训练指导只在 Veli 里。新开栏目，以及法律、付费和对外承诺，由产品负责人决定。</dd></div>\n      \n        <div><span class=\"vc-deflist-n mono\" aria-hidden=\"true\">3</span><dt>怎么核对</dt><dd>发布前，另一个没看过写作过程的智能体独立评审：核对事实、数字和出处，确认英文是按英语读者重写的。健康内容只引用系统综述和大样本研究，并写明研究类型和样本量。文章、里程碑和学习路径步骤都标最后核对日期。</dd></div>\n      \n        <div><span class=\"vc-deflist-n mono\" aria-hidden=\"true\">4</span><dt>错了怎么纠正</dt><dd>每篇文章末尾有纠错入口，你也可以直接写信。改正后记进那一篇的更新记录。产品负责人可以撤下任何一篇；撤下后，那个地址显示「页面不存在」，首页和 RSS 随之更新。</dd></div>\n      \n    </dl>",
 "study": "<div class=\"vc-study-set\">\n      <article class=\"vc-card vc-study\" data-research-card data-credibility=\"高\">\n        <div class=\"vc-study-key\">\n          <h3 class=\"vc-study-topic\">防摔 · 运动</h3>\n          <p class=\"vc-type-metric\" data-research-metric>少 23%</p>\n          <p class=\"vc-grade\" data-grade=\"4\"><span class=\"vc-grade-dots\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></span><span>证据可信度：高</span></p>\n        </div>\n        <div class=\"vc-study-body\">\n          <p class=\"vc-study-claim\">少 23%：这是 60 岁以上、住在社区的人参加运动项目（以平衡和功能训练为主）以后，跌倒次数的降幅。只做抗阻练习的证据不足。</p>\n          <p class=\"vc-study-src\"><span><time datetime=\"2019\">2019</time> · Cochrane 系统综述</span><a class=\"vc-quick\" href=\"https://doi.org/10.1002/14651858.CD012424.pub2\" aria-label=\"读原文：Cochrane 系统综述，2019\">读原文</a></p>\n          <dl class=\"vc-study-meta\">\n            <div><dt>研究类型</dt><dd>随机对照试验的系统综述</dd></div>\n            <div><dt>样本量</dt><dd>59 项试验、12,981 人</dd></div>\n            <div><dt>产品负责人看过</dt><dd><time datetime=\"2026-11-10\">2026-11-10</time></dd></div>\n          </dl>\n        </div>\n      </article>\n    <ol class=\"vc-rows vc-study-rows\">\n        <li class=\"vc-row vc-study-row\" data-research-card data-credibility=\"很低\">\n          <div class=\"vc-study-key\">\n            <h3 class=\"vc-study-topic\">长寿 · 力量训练</h3>\n            <p class=\"vc-grade\" data-grade=\"1\"><span class=\"vc-grade-dots\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></span><span>证据可信度：很低</span></p>\n          </div>\n          <div class=\"vc-study-body\">\n            <p class=\"vc-type-title-3 vc-study-figure\">低 15%</p>\n            <p class=\"vc-study-claim\">低 15%：做肌肉力量训练，与全因死亡风险低这么多有关；每周 30–60 分钟时关联最强。观察性研究，说明不了因果。</p>\n            <p class=\"vc-study-method\">队列研究的系统综述（观察性） · 7 项研究、263,058 人 · 产品负责人看过 <time datetime=\"2026-11-10\">2026-11-10</time></p>\n            <p class=\"vc-study-src\"><span><time datetime=\"2022\">2022</time> · BJSM</span><a class=\"vc-quick\" href=\"https://doi.org/10.1136/bjsports-2021-105061\" aria-label=\"读原文：BJSM，2022\">读原文</a></p>\n          </div>\n        </li>\n        <li class=\"vc-row vc-study-row\" data-research-card data-credibility=\"很低\">\n          <div class=\"vc-study-key\">\n            <h3 class=\"vc-study-topic\">情绪 · 力量训练</h3>\n            <p class=\"vc-grade\" data-grade=\"1\"><span class=\"vc-grade-dots\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></span><span>证据可信度：很低</span></p>\n          </div>\n          <div class=\"vc-study-body\">\n            <p class=\"vc-study-claim\">达到重度抑郁诊断标准的人做力量训练，抑郁症状可能比对照组轻，效应量中等。证据可信度很低，结论还可能变。</p>\n            <p class=\"vc-study-method\">随机对照试验的网状荟萃分析 · 218 项试验、14,170 人 · 效应量 g = −0.49 · 产品负责人看过 <time datetime=\"2026-11-10\">2026-11-10</time></p>\n            <p class=\"vc-study-src\"><span><time datetime=\"2024\">2024</time> · The BMJ</span><a class=\"vc-quick\" href=\"https://doi.org/10.1136/bmj-2023-075847\" aria-label=\"读原文：The BMJ，2024\">读原文</a></p>\n          </div>\n        </li>\n    </ol>\n    </div>",
 "era_origins": "<section class=\"vc-era\" id=\"era-origins\" aria-labelledby=\"era-origins-name\">\n                  <div class=\"vc-era-bar\"><h2 id=\"era-origins-name\" class=\"vc-era-name\">起源</h2><p class=\"vc-era-years\">1950–1985</p><a class=\"vc-quick vc-quick-small vc-era-up\" href=\"#eras\" aria-label=\"回到时代索引\">时代索引 ↑</a></div>\n                  <p class=\"vc-era-route\">这个时代的路线：把知识写成规则和逻辑，让机器照着推理。</p>\n                  <ol class=\"vc-era-list\">\n                    \n                      <li class=\"vc-ms\" id=\"turing-1950\" style=\"--vc-gap-years: 0;\">\n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">1950</span>\n                              <h3 id=\"turing-1950-t\" class=\"row-title vc-serif\">图灵《计算机器与智能》</h3>\n                              <span class=\"vc-ms-what\">不再争论「机器能不能思考」，改问它能不能在对话里让人分不出来。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>一个哲学问题变成了可以检验的问题。</p>\n                              <p class=\"vc-row-foot\">论文 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"https://academic.oup.com/mind/article/LIX/236/433/986238\" aria-label=\"读原文：图灵《计算机器与智能》\">读原文</a></p>\n                            </div>\n                          </details>\n                        \n                        \n                      </li>\n                    \n                      <li class=\"vc-ms\" id=\"dartmouth-1955\" style=\"--vc-gap-years: 5;\">\n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">1955</span>\n                              <h3 id=\"dartmouth-1955-t\" class=\"row-title vc-serif\">McCarthy 等：达特茅斯人工智能提案</h3>\n                              <span class=\"vc-ms-what\">「人工智能」这个名字第一次写进文献。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>第二年夏天的研讨会，让符号主义（用规则和逻辑表示知识）成了主路线。</p>\n                              <p class=\"vc-row-foot\">论文 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"http://jmc.stanford.edu/articles/dartmouth/dartmouth.pdf\" aria-label=\"读原文：McCarthy 等：达特茅斯人工智能提案\">读原文</a></p>\n                            </div>\n                          </details>\n                        \n                        \n                      </li>\n                    \n                      <li class=\"vc-ms\" id=\"perceptron-1958\" style=\"--vc-gap-years: 3;\">\n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">1958</span>\n                              <h3 id=\"perceptron-1958-t\" class=\"row-title vc-serif\">Rosenblatt：感知机</h3>\n                              <span class=\"vc-ms-what\">一个能从例子里调整连接权重的模型，不靠人写规则。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>「从数据里学」这条路线从这里开始；它先被冷落，到 1986 年才回到台前。</p>\n                              <p class=\"vc-row-foot\">论文 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"https://doi.org/10.1037/h0042519\" aria-label=\"读原文：Rosenblatt：感知机\">读原文</a></p>\n                            </div>\n                          </details>\n                        \n                        \n                      </li>\n                    \n                  </ol>\n                </section>",
 "era_llm_open": "<section class=\"vc-era\" id=\"era-llm\" aria-labelledby=\"era-llm-name\">\n                  <div class=\"vc-era-bar\"><h2 id=\"era-llm-name\" class=\"vc-era-name\">大语言模型</h2><p class=\"vc-era-years\">2017–2022</p><a class=\"vc-quick vc-quick-small vc-era-up\" href=\"#eras\" aria-label=\"回到时代索引\">时代索引 ↑</a></div>\n                  <p class=\"vc-era-route\">这个时代的路线：一种通用的结构，加上更多的数据和算力。</p>\n                  <ol class=\"vc-era-list\">\n                    \n                      <li class=\"vc-ms\" id=\"transformer-2017\" style=\"--vc-gap-years: 0;\">\n                        \n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\" open=\"\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">2017</span>\n                              <h3 id=\"transformer-2017-t\" class=\"row-title vc-serif\">Vaswani 等《Attention Is All You Need》</h3>\n                              <span class=\"vc-ms-what\">Transformer 用注意力取代循环，训练可以大规模并行。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>从这里起，模型的规模可以跟着算力一起长。</p>\n                              <p class=\"vc-row-foot\">论文 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"https://arxiv.org/abs/1706.03762\" aria-label=\"读原文：Vaswani 等《Attention Is All You Need》\">读原文</a><a class=\"vc-quick vc-quick-small\" href=\"/mind/learn#zero-to-hero\">跟着学：Neural Networks: Zero to Hero</a></p>\n                            </div>\n                          </details>\n                        \n                      </li>\n                    \n                      <li class=\"vc-ms\" id=\"bitter-lesson-2019\" style=\"--vc-gap-years: 2;\">\n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">2019</span>\n                              <h3 id=\"bitter-lesson-2019-t\" class=\"row-title vc-serif\">萨顿《苦涩的教训》</h3>\n                              <span class=\"vc-ms-what\">七十年的经验：通用方法加上算力，最终胜过人写进去的知识。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>给「只管放大规模」这条路线说清了理由。</p>\n                              <p class=\"vc-row-foot\">文章 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"http://www.incompleteideas.net/IncIdeas/BitterLesson.html\" aria-label=\"读原文：萨顿《苦涩的教训》\">读原文</a></p>\n                            </div>\n                          </details>\n                        \n                        \n                      </li>\n                    \n                      <li class=\"vc-ms\" id=\"scaling-laws-2020\" style=\"--vc-gap-years: 1;\">\n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">2020</span>\n                              <h3 id=\"scaling-laws-2020-t\" class=\"row-title vc-serif\">Kaplan 等：规模定律</h3>\n                              <span class=\"vc-ms-what\">模型、数据、算力一起变大，效果按可预测的规律变好。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>「继续放大」从一种信念变成了算得出来的投入。</p>\n                              <p class=\"vc-row-foot\">论文 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"https://arxiv.org/abs/2001.08361\" aria-label=\"读原文：Kaplan 等：规模定律\">读原文</a><a class=\"vc-quick vc-quick-small\" href=\"/mind/learn#cs336\">跟着学：CS336: Language Modeling from Scratch</a></p>\n                            </div>\n                          </details>\n                        \n                        \n                      </li>\n                    \n                      <li class=\"vc-ms\" id=\"gpt-3-2020\" style=\"--vc-gap-years: 0;\">\n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">2020</span>\n                              <h3 id=\"gpt-3-2020-t\" class=\"row-title vc-serif\">Brown 等：GPT-3《Language Models are Few-Shot Learners》</h3>\n                              <span class=\"vc-ms-what\">一个足够大的模型，只看提示里的几个例子，就能做没有专门训练过的任务。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>不用再为每个任务训练一个模型，改提示词就行。后来的提示词工程，是在这个做法上长出来的。</p>\n                              <p class=\"vc-row-foot\">论文 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"https://arxiv.org/abs/2005.14165\" aria-label=\"读原文：Brown 等：GPT-3《Language Models are Few-Shot Learners》\">读原文</a></p>\n                            </div>\n                          </details>\n                        \n                        \n                      </li>\n                    \n                      <li class=\"vc-ms\" id=\"react-2022\" style=\"--vc-gap-years: 2;\">\n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">2022</span>\n                              <h3 id=\"react-2022-t\" class=\"row-title vc-serif\">Yao 等：ReAct</h3>\n                              <span class=\"vc-ms-what\">让模型交替着推理和行动：想一步，调用一次工具，看结果，再想。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>智能体的基本循环从这里定型。</p>\n                              <p class=\"vc-row-foot\">论文 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"https://arxiv.org/abs/2210.03629\" aria-label=\"读原文：Yao 等：ReAct\">读原文</a><a class=\"vc-quick vc-quick-small\" href=\"/mind/learn#agentic-ai\">跟着学：Agentic AI</a></p>\n                            </div>\n                          </details>\n                        \n                        \n                      </li>\n                    \n                      <li class=\"vc-ms\" id=\"chatgpt-2022\" style=\"--vc-gap-years: 0;\">\n                        \n                          <details class=\"vc-ms-fold\" data-expand=\"inline\">\n                            <summary class=\"vc-ms-sum\">\n                              <span class=\"vc-row-lead\">2022</span>\n                              <h3 id=\"chatgpt-2022-t\" class=\"row-title vc-serif\">OpenAI：ChatGPT</h3>\n                              <span class=\"vc-ms-what\">对话成了界面，大语言模型走进日常工作。</span>\n                            </summary>\n                            <div class=\"vc-ms-more\">\n                              <p class=\"vc-row-line\"><b>为什么是转折</b>用它的人从研究者变成了所有人。</p>\n                              <p class=\"vc-row-foot\">产品 · 最后核对 <time datetime=\"2026-11-04\">2026-11-04</time></p>\n                              <p class=\"vc-ms-links\"><a class=\"vc-quick vc-quick-small\" href=\"https://openai.com/index/chatgpt/\" aria-label=\"读原文：OpenAI：ChatGPT\">读原文</a></p>\n                            </div>\n                          </details>\n                        \n                        \n                      </li>\n                    \n                  </ol>\n                </section>",
 "era_index": "<nav class=\"vc-era-index\" aria-label=\"五个时代\">\n            \n              <a href=\"#era-origins\" aria-current=\"true\"><span>起源</span><span class=\"mono\">1950–1985</span></a>\n            \n              <a href=\"#era-ml\" aria-current=\"false\"><span>机器学习</span><span class=\"mono\">1986–2011</span></a>\n            \n              <a href=\"#era-dl\" aria-current=\"false\"><span>深度学习</span><span class=\"mono\">2012–2016</span></a>\n            \n              <a href=\"#era-llm\" aria-current=\"false\"><span>大语言模型</span><span class=\"mono\">2017–2022</span></a>\n            \n              <a href=\"#era-agents\" aria-current=\"false\"><span>智能体</span><span class=\"mono\">2023–</span></a>\n            \n          </nav>",
 "tag": "<h1 id=\"vc-hero-tag\" class=\"vc-hero-tag vc-type-title-3\" data-edge=\"free\"><span class=\"vc-hero-tag-paper\">AGI 路上的陪练</span><span class=\"vc-hero-tag-ink\" aria-hidden=\"true\">AGI 路上的陪练</span></h1>",
 "claim_title": "<h2 id=\"vc-claim-title\" class=\"vc-type-title-2 vc-claim-title\">AI 走得越快，越要先站稳</h2>",
